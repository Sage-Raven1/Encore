  dialogueLines:
  - speaker: {fileID: 11400000, guid: 5a4cf6c60d2652f49a00eeaa0a5eaa04, type: 2}
    text: Ebi? So you won.
  - speaker: {fileID: 11400000, guid: 5a4cf6c60d2652f49a00eeaa0a5eaa04, type: 2}
    text: 'Thanks for telling me. Oh don''t worry about her. '
  - speaker: {fileID: 11400000, guid: 5a4cf6c60d2652f49a00eeaa0a5eaa04, type: 2}
    text: Ever since your uncle left, you've been a daughter to me, and I'm just
      glad you got to sing with..
  - speaker: {fileID: 11400000, guid: 5a4cf6c60d2652f49a00eeaa0a5eaa04, type: 2}
    text: Your "sister".
