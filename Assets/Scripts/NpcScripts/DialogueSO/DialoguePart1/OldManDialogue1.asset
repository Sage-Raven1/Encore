  dialogueLines:
  - speaker: {fileID: 11400000, guid: 303fb22277d7a8e4eb39a96753b0da77, type: 2}
    text: Hey, kid, whats up. Don't tell me anything important I have a bad memory.
  - speaker: {fileID: 11400000, guid: 303fb22277d7a8e4eb39a96753b0da77, type: 2}
    text: I don't remember a thing, but I think I forgot to do something very important.
  - speaker: {fileID: 11400000, guid: 303fb22277d7a8e4eb39a96753b0da77, type: 2}
    text: I have a bad memory by the way.
