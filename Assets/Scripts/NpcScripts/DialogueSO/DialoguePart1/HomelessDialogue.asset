  m_Script: {fileID: 11500000, guid: c4220acdd7f5ec64ab067873248543d8, type: 3}
  m_Name: HomelessDialogue
  m_EditorClassIdentifier: 
  dialogueLines:
  - speaker: {fileID: 11400000, guid: 769a1579b290d494f8669c08abf7b632, type: 2}
    text: Yo some monster stole my house and made me forget everything.
  - speaker: {fileID: 11400000, guid: 769a1579b290d494f8669c08abf7b632, type: 2}
    text: Good thing a monster hunter who was immune to her power came by and told
      me.
  - speaker: {fileID: 11400000, guid: 769a1579b290d494f8669c08abf7b632, type: 2}
    text: Living in the forest is pretty nice.
