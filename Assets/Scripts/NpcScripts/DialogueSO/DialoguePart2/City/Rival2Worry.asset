  dialogueLines:
  - speaker: {fileID: 11400000, guid: 8d232abf8a30b52479c3f2f9f435cb23, type: 2}
    text: Hey! Ebi, don't get confident just cause you you won your first round!
  - speaker: {fileID: 11400000, guid: 8d232abf8a30b52479c3f2f9f435cb23, type: 2}
    text: I did that too!
  - speaker: {fileID: 11400000, guid: 8d232abf8a30b52479c3f2f9f435cb23, type: 2}
    text: And you killed my girlfriend! I didn't even kill yours!
  - speaker: {fileID: 11400000, guid: 8d232abf8a30b52479c3f2f9f435cb23, type: 2}
    text: How could you!
